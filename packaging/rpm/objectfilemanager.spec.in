%global debug_package %{nil}
%global __os_install_post %{nil}
%global _build_id_links none
%global _binary_payload w3.zstdio
Name: objectfilemanager
Version: @VERSION@
Release: 1
Obsoletes: s3-browser < 1.0.3
Provides: s3-browser = %{version}-%{release}
Summary: Desktop browser and bulk transfer client for object storage
License: MIT
Packager: Primož Ajdišek <bigpod@bigpod.si>
BuildArch: @NATIVE_ARCH@
AutoReqProv: no
Requires: glibc >= 2.31
Requires: gtk3, nss, nspr, at-spi2-atk, at-spi2-core, cups-libs, dbus-libs
Requires: cairo, pango, libX11, libXcomposite, libXdamage, libXext, libXfixes, libXrandr
Requires: mesa-libgbm, expat, libxcb, libxkbcommon, systemd-libs, alsa-lib, glib2, libgcc, libsecret, ca-certificates
Recommends: gnome-keyring

%description
Browse Amazon S3, S3-compatible services, OpenStack Swift, Azure Blob Storage
and Google Cloud Storage.
Upload and download folder trees through a persistent queue with pause and
retry, and review copies, moves, deletions and one-way folder syncs.

%prep
# The shared npm build generates the Electron application payload.

%build

%install
mkdir -p %{buildroot}
cp -a /input/payload/. %{buildroot}/

%check
desktop-file-validate %{buildroot}/usr/share/applications/com.tuxbase.s3browser.desktop

%files
%defattr(-,root,root,-)
/opt/objectfilemanager
/usr/bin/objectfilemanager
/usr/share/applications/com.tuxbase.s3browser.desktop
/usr/share/icons/hicolor/512x512/apps/com.tuxbase.s3browser.png
/usr/share/doc/objectfilemanager
/usr/share/licenses/objectfilemanager
