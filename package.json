{
  "name": "s3-browser",
  "version": "0.1.1",
  "description": "A desktop browser and durable bulk transfer client for S3-compatible, OpenStack Swift, Azure Blob and Google Cloud Storage",
  "license": "MIT",
  "author": {
    "name": "Primož Ajdišek (bigpod)",
    "email": "bigpod@bigpod.si"
  },
  "homepage": "https://github.com/bigpod98/S3Browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigpod98/S3Browser.git"
  },
  "bugs": {
    "url": "https://github.com/bigpod98/S3Browser/issues"
  },
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "node scripts/package-linux.cjs",
    "pack": "electron-builder --dir",
    "test:desktop": "node test/desktop.cjs",
    "test:desktop:providers": "node test/desktop-providers.cjs",
    "test:scale": "node test/scale.cjs",
    "format": "prettier --write src test scripts package.json README.md CONTRIBUTING.md SECURITY.md docs packaging/README.md .github/workflows",
    "check": "prettier --check src test scripts package.json README.md CONTRIBUTING.md SECURITY.md docs packaging/README.md .github/workflows",
    "dist:packages": "node scripts/package-linux.cjs",
    "test:packages": "node scripts/validate-packages.cjs",
    "dist:portable": "electron-builder --linux tar.gz",
    "test:desktop:expansion": "node test/desktop-expansion.cjs"
  },
  "build": {
    "appId": "com.tuxbase.s3browser",
    "productName": "S3 Browser",
    "files": [
      "src/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "afterPack": "./scripts/third-party-notices.cjs",
    "linux": {
      "category": "Utility",
      "target": [
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "desktop": {
        "entry": {
          "Name": "S3 Browser",
          "Comment": "Browse and transfer files in S3, Swift, Azure Blob and Google Cloud Storage"
        }
      },
      "syncDesktopName": true,
      "artifactName": "${name}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/lib-storage": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@azure/storage-blob": "^12.34.0",
    "@google-cloud/storage": "^8.2.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "desktopName": "com.tuxbase.s3browser.desktop",
  "engines": {
    "node": ">=22.13.0"
  }
}
